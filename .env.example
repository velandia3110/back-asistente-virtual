# ───── Entorno ─────
PORT=3000
NODE_ENV=development

# ───── Telegram ─────
TELEGRAM_BOT_TOKEN=your_bot_token_here
WEBHOOK_URL=   # en desarrollo puede ser nulo mientras uses polling

# ───── Base de datos ─────
DATABASE_URL=postgresql://postgres:devpassword123@localhost:5434/gruizajes
# Nota: si la app se ejecuta dentro de otro contenedor Docker, cambia 'localhost' por el nombre del servicio 'postgres'

# ───── Autenticación (Dashboard) ─────
JWT_SECRET=una_clave_secreta_muy_larga_y_aleatoria
JWT_EXPIRES_IN=7d

# ───── Email (notificaciones) ─────
# IMPORTANTE: Si usas Gmail, debes generar una contraseña de aplicación:
# 1. Habilita verificación en dos pasos en tu cuenta Google
# 2. Genera contraseña de aplicación en: https://myaccount.google.com/apppasswords
# 3. Usa esa contraseña en SMTP_PASS, NO tu contraseña de Gmail normal
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_password_de_aplicacion_de_gmail
EMAIL_COMERCIAL=comercial@gruizajes.com
# Si no quieres usar email, deja SMTP_PASS vacío y el sistema solo registrará en logs
