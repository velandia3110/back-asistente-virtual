{
  "name": "gruizajes-bot",
  "version": "1.0.0",
  "description": "Asistente virtual para captura y calificación de leads en Gruizajes via Telegram",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --runInBand",
    "test:e2e": "jest tests/e2e/api.e2e.test.js --runInBand",
    "test:selenium": "jest tests/e2e/selenium.e2e.test.js --runInBand",
    "test:coverage": "jest --coverage --runInBand",
    "migrate": "knex migrate:latest",
    "seed": "knex seed:run"
  },
  "dependencies": {
    "@grammyjs/conversations": "^2.1.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "grammy": "^1.21.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "nodemailer": "^6.9.7",
    "pg": "^8.11.3",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "chromedriver": "^131.0.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "selenium-webdriver": "^4.27.0",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  },
  "packageManager": "pnpm@11.3.0+sha512.2c403d6594527287672b1f7056343a1f7c3634036a67ffabfcc2b3d7595d843768f8787148d1b57cf7956c90606bbd192857c363af19e96d2d0ec9ec5741d215"
}
